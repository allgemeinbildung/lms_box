rules_version = '2';

// Rules for the named database `lmsbox` only. Spec: CONTRACT.md.
// The `(default)` database (Lernportal) has its own rules in another repo and
// is never deployed from here.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isTeacher() {
      return signedIn() && request.auth.token.role == 'teacher';
    }
    // The Firebase project is shared with another app: anonymous sign-in and
    // email/password self-sign-up are enabled on it, so "signed in" does not mean
    // "is a student". These two functions raise the bar: a real student signs in
    // with email/password and an address ending in @lernende.bbw.ch (Auth issues
    // it in lowercase). This does NOT prove roster membership - rules cannot read
    // the roster, which lives in the other database. Anyone who can register such
    // an address passes; the callables check the roster for what matters.
    function notAnonymous() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    //
    // Single sign-on (CONTRACT.md): a session made from the Lernportal login has the
    // provider `custom`. Only the function `boxSsoToken` mints such a token, and only for
    // a password sign-in with this address domain; it sets the claim `lmsboxSso`.
    function isSchoolAccount() {
      return signedIn()
        && ((request.auth.token.firebase.sign_in_provider == 'password'
             && request.auth.token.email.matches('.*@lernende[.]bbw[.]ch$'))
            || (request.auth.token.firebase.sign_in_provider == 'custom'
                && request.auth.token.get('lmsboxSso', false) == true));
    }
    // Document ids of per-student documents start with `${uid}__`.
    function idIsOwn(docId) {
      return signedIn()
        && docId.size() > request.auth.uid.size() + 2
        && docId[0:request.auth.uid.size() + 2] == request.auth.uid + '__';
    }

    // ---- drafts: validation -------------------------------------------------
    //
    // Size guard. Rules cannot measure a document, only count characters, and
    // they have no loops - so the two lists are capped at 6 entries and checked
    // entry by entry. 6 is also what the limit of 1000 evaluated expressions per
    // request allows (12 did not fit; the emulator enforces that limit too).
    // Real content has at most 2 questions per sub-assignment.
    // Budget in characters (a character is at most 4 bytes in UTF-8):
    //   answers   6 x questionId 200             =   1 200
    //             all `answer` strings together  = 200 000
    //   questions 6 x (id 200 + text 4 000)      =  25 200
    //   uid, classId, assignmentId, subId, title, type < 2 000
    //   total < 229 000 characters < 916 000 bytes, plus field names and the
    //   document name: below the Firestore limit of 1 048 576 bytes.

    function shortString(v, max) {
      return v is string && v.size() <= max;
    }
    // Length of answers[i].answer; 0 when there is no such entry. A malformed
    // entry (not a map, missing key) makes the expression error = deny.
    function answerLen(a, i) {
      return a.size() <= i ? 0
        : (a[i].keys().hasOnly(['questionId', 'answer'])
           && shortString(a[i].questionId, 200)
           && a[i].answer is string
             ? a[i].answer.size() : 1000000);
    }
    function answersOk(a) {
      return a is list && a.size() <= 6
        && answerLen(a, 0) + answerLen(a, 1) + answerLen(a, 2)
         + answerLen(a, 3) + answerLen(a, 4) + answerLen(a, 5) <= 200000;
    }
    function questionOk(q, i) {
      return q.size() <= i
        || (q[i].keys().hasOnly(['id', 'text'])
            && shortString(q[i].id, 200)
            && shortString(q[i].text, 4000));
    }
    function questionsOk(q) {
      return q is list && q.size() <= 6
        && questionOk(q, 0) && questionOk(q, 1) && questionOk(q, 2)
        && questionOk(q, 3) && questionOk(q, 4) && questionOk(q, 5);
    }
    function draftOk(draftId) {
      let d = request.resource.data;
      return idIsOwn(draftId)
        && isSchoolAccount()
        && d.keys().hasOnly(['uid', 'classId', 'assignmentId', 'subId', 'title',
                             'type', 'questions', 'answers', 'updatedAt'])
        && d.keys().hasAll(['uid', 'classId', 'assignmentId', 'subId', 'answers', 'updatedAt'])
        && d.uid == request.auth.uid
        && shortString(d.classId, 100)
        && shortString(d.assignmentId, 500) && d.assignmentId.size() > 0
        && shortString(d.subId, 500) && d.subId.size() > 0
        && (!('title' in d) || shortString(d.title, 500))
        && (!('type' in d) || shortString(d.type, 50))
        && (!('questions' in d) || questionsOk(d.questions))
        && answersOk(d.answers)
        && d.updatedAt == request.time;
    }

    // ---- quizProgress: validation -------------------------------------------
    //
    // The self-test («Kurztest») on lehrmittel.aburossi.ch, one document per student
    // and unit (CONTRACT.md). `hard` is checked entry by entry (no loops): at most 20
    // strings of at most 120 characters - real units have at most 14 terms. 30 did not
    // fit: an update evaluates create and update, and ran into the limit of 1000
    // expressions per request (the emulator enforces it too).
    function hardOk(h, i) {
      return h.size() <= i || shortString(h[i], 120);
    }
    function hardListOk(h) {
      return h is list && h.size() <= 20
        && hardOk(h, 0)  && hardOk(h, 1)  && hardOk(h, 2)  && hardOk(h, 3)  && hardOk(h, 4)
        && hardOk(h, 5)  && hardOk(h, 6)  && hardOk(h, 7)  && hardOk(h, 8)  && hardOk(h, 9)
        && hardOk(h, 10) && hardOk(h, 11) && hardOk(h, 12) && hardOk(h, 13) && hardOk(h, 14)
        && hardOk(h, 15) && hardOk(h, 16) && hardOk(h, 17) && hardOk(h, 18) && hardOk(h, 19);
    }
    function lastOk(l) {
      return l is map
        && l.keys().hasOnly(['known', 'total', 'date'])
        && l.keys().hasAll(['known', 'total', 'date'])
        && l.total is int && l.total >= 1 && l.total <= 50
        && l.known is int && l.known >= 0 && l.known <= l.total
        && shortString(l.date, 40)
        && l.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$');
    }
    function quizOk(quizId) {
      let d = request.resource.data;
      return idIsOwn(quizId)
        && quizId.size() <= 1500
        && isSchoolAccount()
        && d.keys().hasOnly(['uid', 'unit', 'last', 'hard', 'updatedAt'])
        && d.keys().hasAll(['uid', 'unit', 'last', 'hard', 'updatedAt'])
        && d.uid == request.auth.uid
        && shortString(d.unit, 300) && d.unit.size() > 0
        && lastOk(d.last)
        && hardListOk(d.hard) && d.hard.size() <= d.last.total
        && d.updatedAt == request.time;
    }

    // ---- mindmapDrafts: validation ------------------------------------------
    //
    // The student's own branches on a mindmap (CONTRACT.md, «Mindmap editor»). `nodes`
    // is JSON the rules cannot parse; only its length is checked, and the page treats
    // what it reads as untrusted.
    function mapOk(mapId) {
      let d = request.resource.data;
      return idIsOwn(mapId)
        && mapId.size() <= 1500
        && isSchoolAccount()
        && d.keys().hasOnly(['uid', 'mapId', 'nodes', 'updatedAt'])
        && d.keys().hasAll(['uid', 'mapId', 'nodes', 'updatedAt'])
        && d.uid == request.auth.uid
        && shortString(d.mapId, 300) && d.mapId.size() > 0
        && shortString(d.nodes, 20000)
        && d.updatedAt == request.time;
    }

    // ---- collections --------------------------------------------------------

    // With solutions and rubrics: teachers only. Students and guests read the
    // public copy below; the formativ function reads this with the Admin SDK.
    match /assignments/{assignmentDoc} {
      allow read: if isTeacher();
      allow write: if isTeacher();
    }

    // The public copy without solutions (CONTRACT.md, «Public copy and guest mode»).
    // Readable one by one without sign-in; written only by the upload script (Admin SDK).
    match /publicAssignments/{assignmentDoc} {
      allow get: if true;
      allow list: if isTeacher();
    }

    // Teacher material of one unit for the preparation page (CONTRACT.md, «Teacher
    // materials»): model answers, rubrics, notes. Teachers read; nobody writes here -
    // only scripts/upload-teacher-materials.mjs (Admin SDK). Students, guests: nothing.
    match /teacherMaterials/{einheitDoc} {
      allow get, list: if isTeacher();
    }

    match /drafts/{draftId} {
      // get: a missing own document answers "does not exist", not "denied".
      allow get: if isTeacher()
        || (notAnonymous() && idIsOwn(draftId) && (resource == null || resource.data.uid == request.auth.uid));
      // list: a student query must carry where('uid', '==', own uid).
      allow list: if isTeacher()
        || (notAnonymous() && resource.data.uid == request.auth.uid);
      allow create: if draftOk(draftId);
      allow update: if draftOk(draftId)
        && resource.data.uid == request.auth.uid
        && request.resource.data.assignmentId == resource.data.assignmentId
        && request.resource.data.subId == resource.data.subId;
      // No delete - not for students, and the contract grants the teacher read only.
    }

    match /feedback/{pairDoc} {
      allow read, write: if isTeacher();
    }

    match /feedbackReleased/{pairDoc} {
      allow get: if isTeacher()
        || (notAnonymous() && idIsOwn(pairDoc) && (resource == null || resource.data.uid == request.auth.uid));
      allow list: if isTeacher()
        || (notAnonymous() && resource.data.uid == request.auth.uid);
      allow write: if isTeacher();
    }

    // Written only by the function (Admin SDK bypasses rules).
    match /formativUsage/{pairDoc} {
      allow read: if isTeacher();
    }

    // Self-test progress: the student's own documents only, no list, no teacher
    // access (CONTRACT.md). Not checked here: that the id is uid + "__" + enc(unit) -
    // rules have no encodeURIComponent; a mismatch only touches the own document.
    match /quizProgress/{quizId} {
      // get: a missing own document answers "does not exist", not "denied".
      allow get: if notAnonymous() && idIsOwn(quizId)
        && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if quizOk(quizId);
      allow update: if quizOk(quizId)
        && resource.data.uid == request.auth.uid
        && request.resource.data.unit == resource.data.unit;
      allow delete: if notAnonymous() && idIsOwn(quizId)
        && resource.data.uid == request.auth.uid;
    }

    // Own mindmap branches: the student's own documents only, no list, no delete, no
    // teacher access (CONTRACT.md). As with quizProgress, that the id is
    // uid + "__" + enc(mapId) is not checked; a mismatch only touches the own document.
    match /mindmapDrafts/{mapId} {
      // get: a missing own document answers "does not exist", not "denied".
      allow get: if notAnonymous() && idIsOwn(mapId)
        && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if mapOk(mapId);
      allow update: if mapOk(mapId)
        && resource.data.uid == request.auth.uid
        && request.resource.data.mapId == resource.data.mapId;
    }

    // Hints that text was inserted rather than typed (CONTRACT.md). Create-only for
    // the student: no read, update or delete, so an entry cannot be taken back.
    match /pasteEvents/{eventDoc} {
      allow read: if isTeacher();
      allow create: if idIsOwn(eventDoc)
        && eventDoc.size() <= 1500
        && isSchoolAccount()
        && request.resource.data.keys().hasOnly(['uid', 'assignmentId', 'subId', 'questionId',
                                                 'kind', 'chars', 'excerpt', 'at'])
        && request.resource.data.keys().hasAll(['uid', 'assignmentId', 'subId', 'questionId',
                                                'kind', 'chars', 'excerpt', 'at'])
        && request.resource.data.uid == request.auth.uid
        && shortString(request.resource.data.assignmentId, 500) && request.resource.data.assignmentId.size() > 0
        && shortString(request.resource.data.subId, 500) && request.resource.data.subId.size() > 0
        && shortString(request.resource.data.questionId, 200)
        && request.resource.data.kind in ['paste', 'drop', 'bulk', 'fast']
        && request.resource.data.chars is int
        && request.resource.data.chars >= 0 && request.resource.data.chars <= 200000
        && shortString(request.resource.data.excerpt, 300)
        && request.resource.data.at == request.time;
    }

    // Emulator-only exception (CONTRACT.md): the roster lives in `(default)`, under
    // the Lernportal's rules. The Firestore emulator applies this one ruleset to
    // every database, so the roster read of the student page needs a match here.
    // Read only. In production `lmsbox` has no `students` collection.
    match /students/{uid} {
      allow read: if isTeacher() || (signedIn() && request.auth.uid == uid);
    }

    // Everything not listed above is denied (no match = no access).
  }
}
